---
---
<section id="experience" class="py-24 relative red-slash-bg text-white border-b-8 border-p5red">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <!-- Section Header -->
        <div class="flex items-center gap-4 mb-16 p5-reveal-slash">
            <div class="bg-p5dark text-white font-anton text-3xl px-6 py-2 skew-box border-2 border-white shadow-[4px_4px_0px_#FFF]">
                <span class="unskew inline-block">04 // MISSION LOGS</span>
            </div>
            <h2 id="exp-heading" class="font-anton text-4xl sm:text-6xl tracking-wider uppercase">Experience</h2>
        </div>

        <!-- Timeline / Mission Logs -->
        <div class="space-y-8 relative before:absolute before:inset-0 before:left-4 sm:before:left-1/2 before:w-1 before:bg-white">
            <!-- Log 1 -->
            <div class="relative flex flex-col sm:flex-row items-center">
                <div class="sm:w-1/2 sm:pr-12 w-full mb-4 sm:mb-0 text-left sm:text-right p5-reveal-left">
                    <div class="ransom-box inline-block px-3 py-1 text-sm mb-2 p5-reveal-pop">2026</div>
                    <h3 class="font-anton text-2xl text-white">SI FEST 2026</h3>
                </div>
                <div class="absolute left-4 sm:left-1/2 -translate-x-1/2 w-8 h-8 bg-p5red border-4 border-white transform rotate-45 z-10 p5-node-pulse"></div>
                <div class="sm:w-1/2 sm:pl-12 w-full p5-reveal-right">
                    <div class="p5-card p5-card-interactive p-6">
                        <p class="text-gray-300 text-sm">Working as member of Technology And Information Development Staff. Speciality in UI/UX design and Frond-End Developer.</p>
                    </div>
                </div>
            </div>
            <!-- Log 2 -->
            <div class="relative flex flex-col sm:flex-row items-center">
                <div class="sm:w-1/2 sm:pr-12 w-full mb-4 sm:mb-0 text-left sm:text-right order-1 sm:order-1 p5-reveal-left">
                    <div class="p5-card p5-card-interactive p-6">
                        <p class="text-gray-300 text-sm">An annual event that held on 17th August. Working as member of Publication and Documentation Staff while also serving as Banner Designer and On-Site Operator</p>
                    </div>
                </div>
                <div class="absolute left-4 sm:left-1/2 -translate-x-1/2 w-8 h-8 bg-white border-4 border-p5red transform rotate-45 z-10 order-2 p5-node-pulse" style="animation-delay: 0.8s;"></div>
                <div class="sm:w-1/2 sm:pl-12 w-full order-3 sm:order-2 p5-reveal-right">
                    <div class="ransom-box-dark inline-block px-3 py-1 text-sm mb-2 p5-reveal-pop">2026</div>
                    <h3 class="font-anton text-2xl text-white">INDONESIA INDEPENDENCE DAY EVENT</h3>
                </div>
            </div>
            <!-- Log 3 -->
            <div class="relative flex flex-col sm:flex-row items-center">
                <div class="sm:w-1/2 sm:pr-12 w-full mb-4 sm:mb-0 text-left sm:text-right p5-reveal-left">
                    <div class="ransom-box inline-block px-3 py-1 text-sm mb-2 p5-reveal-pop">2026</div>
                    <h3 class="font-anton text-2xl text-white">HIMSI IFTAR GATHERING</h3>
                </div>
                <div class="absolute left-4 sm:left-1/2 -translate-x-1/2 w-8 h-8 bg-p5red border-4 border-white transform rotate-45 z-10 p5-node-pulse" style="animation-delay: 1.6s;"></div>
                <div class="sm:w-1/2 sm:pl-12 w-full p5-reveal-right">
                    <div class="p5-card p5-card-interactive p-6">
                        <p class="text-gray-300 text-sm">An annual event that held on month of Ramadan. Working as member of Logistic Staff</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<script>
    (function () {
        const section = document.getElementById('experience');
        const heading = document.getElementById('exp-heading');
        if (!section || !heading) return;
        const GAP = 14;

        function placeSplit() {
            if (!section || !heading) return;
            let x = 0, y = 0, el: HTMLElement | null = heading;
            while (el && el !== section) {
                x += el.offsetLeft;
                y += el.offsetTop;
                el = el.offsetParent as HTMLElement | null;
            }
            x += heading.offsetWidth;
            y += heading.offsetHeight;
            section.style.setProperty('--split', ((x + y + GAP) / Math.SQRT2) + 'px');
        }

        placeSplit();
        window.addEventListener('resize', placeSplit);
        window.addEventListener('load', placeSplit);
        if (document.fonts && document.fonts.ready) {
            document.fonts.ready.then(placeSplit);
        }
    })();
</script>
