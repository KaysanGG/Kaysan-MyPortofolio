---
import { Image } from 'astro:assets';
import sifestImage from '../assets/images/sifest.jpg';
---
<section id="projects" class="py-24 relative bg-black halftone-bg border-b-8 border-p5red">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <!-- Section Header -->
        <div class="flex items-center gap-4 mb-16 p5-reveal-slash">
            <div class="bg-p5red text-white font-anton text-3xl px-6 py-2 skew-box shadow-[4px_4px_0px_#FFF]">
                <span class="unskew inline-block">03 // SHOWCASE</span>
            </div>
            <h2 class="font-anton text-4xl sm:text-6xl tracking-wider uppercase">Projects & Works</h2>
        </div>

        <article>
            <header class="mb-8">
                <h3 class="font-anton text-4xl sm:text-5xl uppercase tracking-wide text-white">SI FEST 2026</h3>
                <p class="mt-2 text-base sm:text-lg text-p5lightgray">A website of Festival Information System</p>
                <div class="skew-box mt-4 h-1.5 w-40 bg-p5red"></div>
            </header>

            <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-16 items-start">
                <div class="lg:col-span-6 px-6 sm:px-8 lg:px-0">
                    <div class="relative">
                        <div class="skew-box border-4 border-white bg-black shadow-[6px_6px_0px_#E60012] overflow-hidden">
                            <Image 
                                src={sifestImage} 
                                alt="SI FEST 2026 website preview"
                                width={800}
                                height={450}
                                class="w-full h-auto object-cover"
                            />
                        </div>
                        <div class="absolute -top-4 left-5 ransom-box pointer-events-none px-3 py-1 text-sm">★ PROJECT 01</div>
                    </div>
                </div>

                <div class="lg:col-span-6 space-y-5">
                    <ul class="space-y-2 font-anton text-lg uppercase tracking-wide text-white">
                        <li class="flex items-start gap-3"><span class="text-p5red">★</span>Front-End Developer</li>
                    </ul>
                    <p class="text-gray-300 text-sm sm:text-base leading-relaxed">
                        An Official website for the Information Systems festival, featuring an integrated Oscar chatbot for interactive information services.
                    </p>

                    <div class="flex flex-wrap gap-2">
                        <span class="skew-box border-2 border-p5red bg-p5dark text-white font-mono text-xs sm:text-sm font-bold uppercase tracking-wider px-3 py-1"><span class="unskew inline-block">REACT</span></span>
                        <span class="skew-box border-2 border-p5red bg-p5dark text-white font-mono text-xs sm:text-sm font-bold uppercase tracking-wider px-3 py-1"><span class="unskew inline-block">LARAVEL</span></span>
                        <span class="skew-box border-2 border-p5red bg-p5dark text-white font-mono text-xs sm:text-sm font-bold uppercase tracking-wider px-3 py-1"><span class="unskew inline-block">MYSQL</span></span>
                        <span class="skew-box border-2 border-p5red bg-p5dark text-white font-mono text-xs sm:text-sm font-bold uppercase tracking-wider px-3 py-1"><span class="unskew inline-block">TAILWIND CSS</span></span>
                    </div>

                    <a href="https://sifestunsri.com/" target="_blank" rel="noopener noreferrer" class="skew-box inline-flex bg-p5red hover:bg-white hover:text-p5dark text-white font-anton text-lg px-5 py-3 border-2 border-white shadow-[4px_4px_0px_#FFF] focus:outline-none focus-visible:ring-4 focus-visible:ring-white/60">
                        <span class="unskew inline-flex items-center gap-2">sifestunsri.com <span aria-hidden="true">↗</span></span>
                    </a>
                </div>
            </div>
        </article>
    </div>
</section>
