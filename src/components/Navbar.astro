<header class="relative w-full z-40 bg-p5dark border-b-4 border-p5red">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-center justify-between h-20">
            <!-- Logo / Persona Tag -->
            <a href="#hero" class="flex items-center gap-3 group">
                <div class="bg-white text-black border-2 border-p5yellow font-anton text-2xl px-3 py-1 skew-box shadow-[3px_3px_0px_#FFE600] group-hover:rotate-3 transition-transform">
                    <span class="unskew inline-block">K-SAN</span>
                </div>
                <span class="font-anton text-2xl tracking-wider text-white uppercase italic">Rafi.A <span class="text-p5yellow">//</span> Bilingual</span>
            </a>

            <div class="flex items-center gap-3">
                <div class="hidden lg:flex items-center gap-3 mr-2">
                    <a href="https://github.com/KaysanGG" target="_blank" rel="noopener noreferrer" aria-label="GitHub" title="GitHub"
                        class="skew-box w-10 h-10 flex items-center justify-center bg-p5dark hover:bg-p5red text-white border-2 border-white hover:border-p5red shadow-[3px_3px_0px_#FFF] focus:outline-none focus-visible:ring-4 focus-visible:ring-white/60">
                        <i class="fa-brands fa-github text-lg unskew inline-block"></i>
                    </a>
                    <a href="https://www.linkedin.com/in/kaysan-rafi-akbar-757639326" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn" title="LinkedIn"
                        class="skew-box w-10 h-10 flex items-center justify-center bg-p5dark hover:bg-p5red text-white border-2 border-white hover:border-p5red shadow-[3px_3px_0px_#FFF] focus:outline-none focus-visible:ring-4 focus-visible:ring-white/60">
                        <i class="fa-brands fa-linkedin text-lg unskew inline-block"></i>
                    </a>
                    <a href="https://www.instagram.com/rafi.zz_42" target="_blank" rel="noopener noreferrer" aria-label="Instagram" title="Instagram"
                        class="skew-box w-10 h-10 flex items-center justify-center bg-p5dark hover:bg-p5red text-white border-2 border-white hover:border-p5red shadow-[3px_3px_0px_#FFF] focus:outline-none focus-visible:ring-4 focus-visible:ring-white/60">
                        <i class="fa-brands fa-instagram text-lg unskew inline-block"></i>
                    </a>
                    <a href="https://x.com/kaysan_rafi" target="_blank" rel="noopener noreferrer" aria-label="X (Twitter)" title="X (Twitter)"
                        class="skew-box w-10 h-10 flex items-center justify-center bg-p5dark hover:bg-p5red text-white border-2 border-white hover:border-p5red shadow-[3px_3px_0px_#FFF] focus:outline-none focus-visible:ring-4 focus-visible:ring-white/60">
                        <i class="fa-brands fa-x-twitter text-lg unskew inline-block"></i>
                    </a>
                    <a href="https://steamcommunity.com/profiles/76561199776292419/" target="_blank" rel="noopener noreferrer" aria-label="Steam" title="Steam"
                        class="skew-box w-10 h-10 flex items-center justify-center bg-p5dark hover:bg-p5red text-white border-2 border-white hover:border-p5red shadow-[3px_3px_0px_#FFF] focus:outline-none focus-visible:ring-4 focus-visible:ring-white/60">
                        <i class="fa-brands fa-steam text-lg unskew inline-block"></i>
                    </a>
                </div>

                <a href="mailto:kaysanrafizz@gmail.com" title="Email kaysanrafizz@gmail.com" class="hidden sm:flex skew-box bg-white hover:bg-p5dark hover:text-white text-p5dark font-anton text-lg px-4 py-3 border-2 border-p5red shadow-[3px_3px_0px_#E60012] focus:outline-none focus-visible:ring-4 focus-visible:ring-white/60">
                    <span class="unskew inline-flex items-center gap-2 uppercase tracking-wider">
                        <i class="fa-solid fa-envelope"></i> Hire Me
                    </span>
                </a>

                <div class="relative">
                    <button id="menu-btn" type="button"
                        aria-label="Open menu" aria-expanded="false" aria-controls="menu-panel"
                        class="skew-box bg-p5red hover:bg-white hover:text-p5dark text-white font-anton text-lg px-4 py-3 border-2 border-white shadow-[3px_3px_0px_#FFF] focus:outline-none focus-visible:ring-4 focus-visible:ring-white/60">
                        <span class="unskew inline-flex items-center gap-3">
                            <i id="menu-icon" class="fa-solid fa-bars text-xl"></i>
                            <span class="hidden sm:inline uppercase tracking-wider">Menu</span>
                        </span>
                    </button>

                    <nav id="menu-panel" aria-label="Main"
                        class="hidden absolute right-0 top-full mt-4 z-50 w-[min(18rem,calc(100vw-2rem))] bg-p5dark border-4 border-white shadow-[8px_8px_0px_#E60012] p-4 space-y-3">
                        <a href="#about" class="menu-link nav-p5-link skew-box block bg-p5dark hover:bg-p5red text-white font-anton px-4 py-2 text-xl border-2 border-white hover:border-p5red transition-all shadow-[3px_3px_0px_#FFF]">
                            <span class="unskew inline-block nav-text">About Me</span>
                        </a>
                        <a href="#skills" class="menu-link nav-p5-link skew-box block bg-p5dark hover:bg-p5red text-white font-anton px-4 py-2 text-xl border-2 border-white hover:border-p5red transition-all shadow-[3px_3px_0px_#FFF]">
                            <span class="unskew inline-block nav-text">Skills</span>
                        </a>
                        <a href="#projects" class="menu-link nav-p5-link skew-box block bg-p5dark hover:bg-p5red text-white font-anton px-4 py-2 text-xl border-2 border-white hover:border-p5red transition-all shadow-[3px_3px_0px_#FFF]">
                            <span class="unskew inline-block nav-text">Projects</span>
                        </a>
                        <a href="#experience" class="menu-link nav-p5-link skew-box block bg-p5dark hover:bg-p5red text-white font-anton px-4 py-2 text-xl border-2 border-white hover:border-p5red transition-all shadow-[3px_3px_0px_#FFF]">
                            <span class="unskew inline-block nav-text">Experience</span>
                        </a>
                    </nav>
                </div>
            </div>
        </div>
    </div>
</header>

<script>
    const menuBtn = document.getElementById('menu-btn');
    const menuPanel = document.getElementById('menu-panel');
    const menuIcon = document.getElementById('menu-icon');
    const menuLinks = document.querySelectorAll('.menu-link');

    function setMenu(open: boolean) {
        if (!menuPanel || !menuBtn || !menuIcon) return;
        menuPanel.classList.toggle('hidden', !open);
        menuPanel.classList.toggle('is-open', open);
        menuBtn.setAttribute('aria-expanded', String(open));
        menuBtn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
        menuIcon.classList.toggle('fa-bars', !open);
        menuIcon.classList.toggle('fa-xmark', open);
    }

    if (menuBtn && menuPanel) {
        menuBtn.addEventListener('click', (e) => {
            e.stopPropagation();
            setMenu(menuPanel.classList.contains('hidden'));
        });

        menuLinks.forEach(link => link.addEventListener('click', () => setMenu(false)));

        document.addEventListener('click', (e) => {
            const target = e.target as Node;
            if (!menuPanel.classList.contains('hidden') && !menuPanel.contains(target)) {
                setMenu(false);
            }
        });

        document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape' && !menuPanel.classList.contains('hidden')) {
                setMenu(false);
                menuBtn.focus();
            }
        });
    }
</script>
