---
import { Image } from 'astro:assets';
import heartImage from '../assets/images/pixel-heart.png';
---
<section id="about" class="py-24 relative bg-black halftone-bg border-b-8 border-p5red overflow-hidden">
    <!-- Subtle Background Comic Star -->
    <div class="absolute -right-6 top-10 text-p5red/10 text-9xl font-anton select-none pointer-events-none p5-star-spin" style="animation-duration: 35s;">★</div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
        <!-- Section Header -->
        <div class="flex items-center gap-4 mb-16 p5-reveal-slash">
            <div class="bg-p5red text-white font-anton text-3xl px-6 py-2 skew-box shadow-[4px_4px_0px_#FFF]">
                <span class="unskew inline-block">01 // PROFILE</span>
            </div>
            <h2 class="font-anton text-4xl sm:text-6xl tracking-wider uppercase">About Me</h2>
        </div>

        <!-- Upscaled Background Panel (Spans full width to right side) -->
        <div class="w-full p5-reveal-card">
            <div class="p5-card p-8 sm:p-12 transform -skew-x-2 border-4 border-white shadow-[10px_10px_0px_#E60012] group">
                <div style="transform: skewX(2deg);">
                    <div class="flex items-center justify-between mb-6 border-b-4 border-p5red pb-4">
                        <span class="font-anton text-3xl sm:text-4xl text-p5red tracking-wider">BACKGROUND</span>
                        <i class="fa-solid fa-user-ninja text-3xl sm:text-4xl text-white group-hover:rotate-12 group-hover:scale-125 transition-transform duration-300"></i>
                    </div>
                    <p class="text-gray-200 text-lg sm:text-2xl leading-relaxed max-w-5xl">
                        Everybody call me Kaysan, I am a university student that specializing in high-impact visual storytelling, game testing, media editing and cutting-edge user interfaces. I also do playing game a lot especially turn-based JRPGs and Roguelikes.
                    </p>
                    <div class="mt-8 flex flex-wrap gap-4">
                        <div class="inline-flex items-center gap-3 ransom-box pointer-events-none text-base px-4 py-2 p5-reveal-pop shadow-[4px_4px_0px_#000]">
                            <span class="p5-heart-beat">
                                <Image src={heartImage} alt="" aria-hidden="true" class="block h-6 w-6 shrink-0" style="image-rendering: pixelated;" />
                            </span>
                            <span>Despite everything, It's still you.</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
