---
---
<section id="skills" class="py-24 relative bg-p5dark border-b-8 border-p5red overflow-hidden">
    <!-- Background decorative text -->
    <div class="absolute -right-20 top-1/2 -translate-y-1/2 text-[18vw] font-anton text-white/[0.03] select-none pointer-events-none uppercase">
        SKILLS
    </div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
        <!-- Section Header -->
        <div class="flex items-center gap-4 mb-16 p5-reveal-slash">
            <div class="bg-white text-p5dark font-anton text-3xl px-6 py-2 skew-box shadow-[4px_4px_0px_#E60012]">
                <span class="unskew inline-block">02 // INVENTORY</span>
            </div>
            <h2 class="font-anton text-4xl sm:text-6xl tracking-wider uppercase">Skills & Services</h2>
        </div>

        <!-- Game Menu Style Layout -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
            <!-- Left: Menu Navigation List -->
            <div class="lg:col-span-5 space-y-3 p5-reveal-left">
                <div class="ransom-box pointer-events-none px-4 py-2 text-xl mb-4 inline-block p5-reveal-pop">SELECT COMMAND</div>
                
                <button type="button" aria-pressed="true" class="skill-tab w-full text-left cursor-pointer bg-p5red text-white p-4 border-2 border-white skew-box shadow-[5px_5px_0px_#FFF] flex items-center justify-between transition-all translate-x-1" data-skill="game-review">
                    <span class="unskew font-anton text-2xl skill-label flex items-center gap-2">
                        <span class="active-arrow text-white mr-1">&gt;&gt;</span>
                        <i class="fa-solid fa-file-lines mr-2"></i> 01. NARRATIVE DESIGN
                    </span>
                    <span class="active-badge unskew bg-white text-p5dark font-anton px-2 py-0.5 text-xs shadow-[2px_2px_0px_#000]">EQUIPPED</span>
                </button>

                <button type="button" aria-pressed="false" class="skill-tab w-full text-left cursor-pointer bg-p5gray hover:bg-white hover:text-p5dark text-white p-4 border-2 border-white hover:border-p5red skew-box shadow-[4px_4px_0px_#FFF] hover:shadow-[5px_5px_0px_#E60012] flex items-center justify-between transition-all" data-skill="ui-ux">
                    <span class="unskew font-anton text-2xl skill-label flex items-center gap-2">
                        <span class="active-arrow text-white mr-1 hidden">&gt;&gt;</span>
                        <i class="fa-solid fa-palette mr-2"></i> 02. UI/UX DESIGN
                    </span>
                    <span class="active-badge unskew bg-white text-p5dark font-anton px-2 py-0.5 text-xs shadow-[2px_2px_0px_#000] hidden">EQUIPPED</span>
                </button>

                <button type="button" aria-pressed="false" class="skill-tab w-full text-left cursor-pointer bg-p5gray hover:bg-white hover:text-p5dark text-white p-4 border-2 border-white hover:border-p5red skew-box shadow-[4px_4px_0px_#FFF] hover:shadow-[5px_5px_0px_#E60012] flex items-center justify-between transition-all" data-skill="qa-testing">
                    <span class="unskew font-anton text-2xl skill-label flex items-center gap-2">
                        <span class="active-arrow text-white mr-1 hidden">&gt;&gt;</span>
                        <i class="fa-solid fa-gamepad mr-2"></i> 03. QA TESTING
                    </span>
                    <span class="active-badge unskew bg-white text-p5dark font-anton px-2 py-0.5 text-xs shadow-[2px_2px_0px_#000] hidden">EQUIPPED</span>
                </button>

                <button type="button" aria-pressed="false" class="skill-tab w-full text-left cursor-pointer bg-p5gray hover:bg-white hover:text-p5dark text-white p-4 border-2 border-white hover:border-p5red skew-box shadow-[4px_4px_0px_#FFF] hover:shadow-[5px_5px_0px_#E60012] flex items-center justify-between transition-all" data-skill="video-editing">
                    <span class="unskew font-anton text-2xl skill-label flex items-center gap-2">
                        <span class="active-arrow text-white mr-1 hidden">&gt;&gt;</span>
                        <i class="fa-solid fa-film mr-2"></i> 04. MEDIA EDITING
                    </span>
                    <span class="active-badge unskew bg-white text-p5dark font-anton px-2 py-0.5 text-xs shadow-[2px_2px_0px_#000] hidden">EQUIPPED</span>
                </button>
            </div>

            <!-- Right: Dynamic Skill Detail Box -->
            <div class="lg:col-span-7 p5-reveal-right">
                <div class="bg-p5dark border-4 border-p5red p-8 relative shadow-[10px_10px_0px_#E60012] transform skew-x-1">
                    <div style="transform: skewX(-1deg);">
                        <div id="skill-content-area" class="space-y-6">
                            <div class="flex items-center justify-between border-b-2 border-white pb-4">
                                <h3 id="skill-title" class="font-anton text-3xl text-p5red uppercase">Narrative Design & Deep Analysis</h3>
                                <span class="bg-p5red text-white font-anton px-3 py-1 text-sm shadow-[2px_2px_0px_#000]">CATEGORY: WRITING</span>
                            </div>
                            <p id="skill-desc" class="text-gray-300 text-lg leading-relaxed">
                                Designing the story a player actually plays: branching plots, character arcs, worldbuilding, and dialogue shaped so that narrative, mechanics, and player choice work together and every decision carries emotional weight.
                            </p>
                            <div class="space-y-3">
                                <div class="font-anton text-xl text-white">KEY PROFICIENCIES:</div>
                                <div id="skill-tags" class="flex flex-wrap gap-2">
                                    <span class="bg-p5gray text-white border border-p5red px-3 py-1 font-mono text-sm">Branching Narrative</span>
                                    <span class="bg-p5gray text-white border border-p5red px-3 py-1 font-mono text-sm">Dialogue Writing</span>
                                    <span class="bg-p5gray text-white border border-p5red px-3 py-1 font-mono text-sm">Worldbuilding</span>
                                    <span class="bg-p5gray text-white border border-p5red px-3 py-1 font-mono text-sm">Character Arcs</span>
                                    <span class="bg-p5gray text-white border border-p5red px-3 py-1 font-mono text-sm">Quest Design</span>
                                    <span class="bg-p5gray text-white border border-p5red px-3 py-1 font-mono text-sm">Ludonarrative Design</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<script>
    type SkillItem = {
        title: string;
        category: string;
        desc: string;
        tags: string[];
    };

    const skillsData: Record<string, SkillItem> = {
        'game-review': {
            title: 'Narrative Design & Deep Analysis',
            category: 'WRITING',       
            desc: 'Designing the story a player actually plays: branching plots, character arcs, worldbuilding, and dialogue shaped so that narrative, mechanics, and player choice work together and every decision carries emotional weight.',
            tags: ['Branching Narrative', 'Dialogue Writing', 'Worldbuilding', 'Character Arcs', 'Quest Design', 'Ludonarrative Design']
        },
        'ui-ux': {
            title: 'UI/UX Design & Brutalist Systems',
            category: 'DESIGN',
            desc: 'Designing high-impact digital interfaces and component systems that defy boring design trends. Specializing in high contrast, slanted geometry, and unforgettable user experiences.',
            tags: ['Figma', 'Tailwind CSS', 'Design Systems', 'Interactive Prototypes']
        },
        'qa-testing': {
            title: 'QA Testing & Bug Reporting',
            category: 'TESTING',
            desc: 'Playtesting builds methodically to find, reproduce, and document bugs, from gameplay and UI glitches to broken quest and dialogue flow, with clear reports that help developers fix issues fast and ship a smoother player experience.',
            tags: ['Bug Reporting', 'Test Case Writing', 'Playtesting', 'Regression Testing', 'Edge Case Analysis']
        },
        'video-editing': {
            title: 'Dynamic Photo & Video Editing',
            category: 'EDITING',
            desc: 'Turning raw photos and footage into polished, scroll-stopping visuals: retouching and color grading for mood, tight pacing, motion graphics, and layered sound design that keep viewers engaged from the first frame to the last.',
            tags: ['Premiere Pro', 'After Effects', 'CapCut', 'Color Grading', 'Photo Retouching', 'Sound Design']
        }
    };

    function updateActiveTab(activeSkill: string) {
        document.querySelectorAll('.skill-tab').forEach(tab => {
            const isMatch = tab.getAttribute('data-skill') === activeSkill;
            tab.setAttribute('aria-pressed', String(isMatch));

            const arrow = tab.querySelector('.active-arrow');
            const badge = tab.querySelector('.active-badge');

            if (isMatch) {
                tab.className = 'skill-tab w-full text-left cursor-pointer bg-p5red text-white p-4 border-2 border-white skew-box shadow-[5px_5px_0px_#FFF] flex items-center justify-between transition-all translate-x-1';
                if (arrow) arrow.classList.remove('hidden');
                if (badge) badge.classList.remove('hidden');
            } else {
                tab.className = 'skill-tab w-full text-left cursor-pointer bg-p5gray hover:bg-white hover:text-p5dark text-white p-4 border-2 border-white hover:border-p5red skew-box shadow-[4px_4px_0px_#FFF] hover:shadow-[5px_5px_0px_#E60012] flex items-center justify-between transition-all';
                if (arrow) arrow.classList.add('hidden');
                if (badge) badge.classList.add('hidden');
            }
        });
    }

    function showSkillDetail(skillKey: string) {
        const data = skillsData[skillKey];
        if (!data) return;

        updateActiveTab(skillKey);

        const titleEl = document.getElementById('skill-title');
        const contentArea = document.getElementById('skill-content-area');
        const descEl = document.getElementById('skill-desc');
        const tagsContainer = document.getElementById('skill-tags');

        if (contentArea) {
            // Re-trigger snappy Persona cut-in animation
            contentArea.classList.remove('p5-cut-in');
            void contentArea.offsetWidth; // Force reflow
            contentArea.classList.add('p5-cut-in');

            const catBadge = contentArea.querySelector('span.bg-p5red');
            if (catBadge) catBadge.textContent = `CATEGORY: ${data.category}`;
        }

        if (titleEl) titleEl.textContent = data.title;
        if (descEl) descEl.textContent = data.desc;
        
        if (tagsContainer) {
            tagsContainer.innerHTML = '';
            data.tags.forEach((tag, idx) => {
                const span = document.createElement('span');
                span.className = 'bg-p5gray text-white border border-p5red px-3 py-1 font-mono text-sm inline-block';
                span.style.animation = `p5SlamIn 0.35s cubic-bezier(0.22, 1, 0.36, 1) both ${idx * 0.05}s`;
                span.textContent = tag;
                tagsContainer.appendChild(span);
            });
        }
    }

    document.querySelectorAll('.skill-tab').forEach(tab => {
        tab.addEventListener('click', () => {
            const skill = tab.getAttribute('data-skill');
            if (skill) showSkillDetail(skill);
        });
    });
</script>
